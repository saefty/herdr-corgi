#!/bin/sh
# A stand-in for Claude Code: logged in, and as an agent shows its task and reports working. No network, no model.
[ "$1 $2" = "auth status" ] && { echo '{"loggedIn": true}'; exit 0; }
printf '\033]7501;app=claude-code:state=working\007'
printf '\n > %s\n\n ● On it.\n' "$*"
exec sleep 86400
