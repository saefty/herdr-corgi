{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/corgi.svg",
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agents"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs-row",
          "type": "row",
          "size": {
            "px": 42
          },
          "resizable": false,
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "window_drag": true,
              "content": {
                "mod": "tabs"
              }
            },
            {
              "id": "timetrack",
              "type": "block",
              "size": {
                "px": 76
              },
              "window_drag": true,
              "content": {
                "mod": "timetrack",
                "props": {
                  "part": "bar"
                }
              }
            }
          ]
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              },
              "floating": [
                {
                  "id": "corgi",
                  "content": {
                    "mod": "corgi"
                  },
                  "edge": "bottom",
                  "align": "start"
                },
                {
                  "id": "resume",
                  "content": {
                    "mod": "resume"
                  },
                  "edge": "top",
                  "align": "end"
                },
                {
                  "id": "dictate",
                  "content": {
                    "mod": "dictate"
                  },
                  "edge": "bottom",
                  "align": "center"
                },
                {
                  "id": "chatbar",
                  "content": {
                    "mod": "chatbar"
                  },
                  "edge": "bottom",
                  "align": "end"
                }
              ]
            },
            {
              "id": "review",
              "type": "column",
              "size": {
                "px": 380
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "pr",
                  "type": "block",
                  "content": {
                    "mod": "pr-review"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ]
    }
  ]
}
